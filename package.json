{
  "name": "bookly",
  "version": "2.0.0-phase1",
  "private": true,
  "description": "Bookly 2.0 — AI yordamida elektron kitob yaratish platformasi (mobile-first, Telegram Mini App mos)",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs dist 5173",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:core": "tsc -p tsconfig.core.json --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node scripts/test-unit.mjs",
    "test:live": "node scripts/live-check.mjs",
    "test:e2e": "node scripts/build.mjs && node --test --test-concurrency=1 tests/e2e/flows.test.mjs tests/e2e/cloud.test.mjs"
  },
  "dependencies": {
    "docx": "^9.8.1",
    "jszip": "^3.10.1",
